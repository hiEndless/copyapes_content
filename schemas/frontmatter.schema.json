{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copyapes.com/schemas/content-frontmatter.schema.json",
  "title": "CopyApeS Content Frontmatter",
  "type": "object",
  "required": [
    "slug",
    "title",
    "description",
    "category",
    "status",
    "published_at",
    "updated_at"
  ],
  "additionalProperties": true,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "legal",
        "tutorial",
        "blog"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cover_image": {
      "type": "string",
      "pattern": "^(@asset:|https://).+"
    },
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "source_locale": {
      "type": "string",
      "enum": [
        "zh-CN",
        "zh-TW",
        "en-US",
        "ja-JP",
        "ko-KR"
      ]
    },
    "translation_source": {
      "type": "string",
      "enum": [
        "zh-CN",
        "zh-TW",
        "en-US",
        "ja-JP",
        "ko-KR"
      ]
    },
    "translation_status": {
      "type": "string",
      "enum": [
        "source",
        "machine",
        "reviewed",
        "final"
      ]
    },
    "published_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    }
  }
}
