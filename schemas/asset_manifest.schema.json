{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copyapes.com/schemas/content-asset-manifest.schema.json",
  "title": "CopyApeS Content Asset Manifest",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "local_path",
      "r2_key",
      "url",
      "sha256",
      "size",
      "content_type",
      "updated_at"
    ],
    "additionalProperties": false,
    "properties": {
      "local_path": {
        "type": "string",
        "pattern": "^assets/images/(shared|zh-CN|zh-TW|en-US|ja-JP|ko-KR)/(legal|tutorials|blog)/.+"
      },
      "r2_key": {
        "type": "string",
        "pattern": "^content/images/(shared|zh-CN|zh-TW|en-US|ja-JP|ko-KR)/(legal|tutorials|blog)/.+"
      },
      "url": {
        "type": "string",
        "pattern": "^$|^https://.+"
      },
      "sha256": {
        "type": "string",
        "pattern": "^$|^[a-f0-9]{64}$"
      },
      "size": {
        "type": "integer",
        "minimum": 0
      },
      "content_type": {
        "type": "string",
        "enum": [
          "image/avif",
          "image/gif",
          "image/jpeg",
          "image/png",
          "image/svg+xml",
          "image/webp"
        ]
      },
      "updated_at": {
        "type": "string",
        "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}
